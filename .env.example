# Copy to .env and fill in. Never commit a real .env file.
# includes/config.php loads this file into the environment; it contains no credentials.

# Required: database (used by includes/Database.php)
DB_DSN="mysql:host=127.0.0.1;dbname=phpretro;charset=utf8mb4"
DB_USER="root"
DB_PASS=""

# Optional: mail (overrides phpretro_site_settings when set)
MAIL_FROM=""
MAIL_FROM_NAME=""
MAIL_LOG=""

# Optional: PolarIS CMS HTTP + RCON (used by includes/PhpretroPolarisCms.php)
POLARIS_CMS_URL=""
POLARIS_CMS_KEY=""
POLARIS_CMS_SECRET=""
POLARIS_RCON_HOST=""
POLARIS_RCON_PORT=""

# Cache: file (default, ./cache) or redis (ext-redis or Predis; falls back to file)
CACHE_DRIVER="file"
CACHE_PATH=""
CACHE_PREFIX="phpretro"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DATABASE="0"
