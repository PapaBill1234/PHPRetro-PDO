ErrorDocument 404 /error.php

# Apache 2.4: disable directory listings and satisfy mod_rewrite without
# granting unrestricted symbolic-link following.
Options -Indexes +SymLinksIfOwnerMatch -MultiViews

# Never serve deployment/configuration files from the web root.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:bak|conf|dist|env|ini|log|old|orig|sql|swp|yml|yaml)$">
    Require all denied
</FilesMatch>

# PHP 8 settings are managed by php.ini. The former mod_php5 block is obsolete.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^web-gallery/js/local/com\.js$ habblet/null.php [END]
    RewriteRule ^web-gallery/styles/local/com\.css$ habblet/null.php [END]
    RewriteRule ^web-gallery(?:/|$) - [END]

    RewriteRule ^security_check_token$ security_check?type=token [END]
    RewriteRule ^xml/promo_(.*)\.xml$ xml/promo_$1.php [END]
    RewriteRule ^papers/(.*)$ papers.php?page=$1 [END]
    RewriteRule ^account/([^/]+)(?:/([^/]+))?$ account.php?var1=$1&var2=$2 [QSA,END]
    RewriteRule ^register/cancel$ register.php?registerCancel=true [END]
    RewriteRule ^captcha\.jpg$ captcha/captcha.php [END]
    RewriteRule ^minimail/loadMessage$ habblet/minimail_loadMessages.php [END]
    RewriteRule ^minimail/(.*)$ habblet/minimail_$1.php [END]
    RewriteRule ^habblet/ajax/(.*)$ habblet/ajax_$1.php [END]

    RewriteRule ^myhabbo/store/purchase_confirm$ habblet/myhabbo_store_purchase_confirm.php [END]
    RewriteRule ^myhabbo/store/purchase_(.*)$ habblet/myhabbo_store_purchase.php?type=$1 [END]
    RewriteRule ^myhabbo/startSession/(.*)$ habblet/myhabbo_homes?id=$1&type=startSession [END]
    RewriteRule ^myhabbo/cancel/(.*)$ habblet/myhabbo_homes?id=$1&type=cancel [END]
    RewriteRule ^myhabbo/save$ habblet/myhabbo_homes?type=save [END]
    RewriteRule ^myhabbo/(.*)/(.*)/(.*)$ habblet/myhabbo_$1_$2_$3.php [END]
    RewriteRule ^myhabbo/(.*)/(.*)$ habblet/myhabbo_$1_$2.php [END]

    RewriteRule ^quickmenu/(.*)$ habblet/quickmenu.php?key=$1 [END]
    RewriteRule ^grouppurchase/(.*)$ habblet/grouppurchase_$1.php [END]
    RewriteRule ^habboclub/(.*)$ habblet/habboclub_$1.php [END]
    RewriteRule ^profile/wardrobeStore$ habblet/wardrobeStore.php [END]
    RewriteRule ^profile/(.*)$ profile.php?do=$1 [END]
    RewriteRule ^home/(.*)/id$ home.php?id=$1 [END]
    RewriteRule ^home/(.*)$ home.php?name=$1 [END]

    RewriteRule ^articles/archive$ articles.php?archive=true [QSA,END]
    RewriteRule ^articles/category/(.*)$ articles.php?category=$1 [END]
    RewriteRule ^articles/rss\.xml$ xml/rss.php [END]
    RewriteRule ^articles/(.*)-(.*)/in/category/(.*)$ articles.php?id=$1&category=$3 [END]
    RewriteRule ^articles/(.*)-(.*)/in/archive$ articles.php?id=$1&archive=true [END]
    RewriteRule ^articles/(.*)-(.*)$ articles.php?id=$1 [END]

    RewriteRule ^habbo-imaging/badge/(.*)\.gif$ habbo-imaging/badge.php?badge=$1 [END]
    RewriteRule ^habbo-imaging/avatar/(.*),(.*),(.*)\.gif$ cache/avatars/$1,$2,$3.png [END]
    RewriteRule ^friendmanagement/ajax/(.*)$ habblet/friendmanagement_$1.php [END]
    RewriteRule ^groups/actions/(.*)/(.*)$ habblet/groups_actions_$1.php?id=$2 [QSA,END]
    RewriteRule ^groups/actions/(.*)$ habblet/groups_actions_$1.php [END]
    RewriteRule ^groups/(.*)/id/discussions/page/(.*)$ discussions.php?id=$1&page=$2 [END]
    RewriteRule ^groups/(.*)/discussions/page/(.*)$ discussions.php?alias=$1&page=$2 [END]
    RewriteRule ^groups/(.*)/id/discussions/(.*)/id/page/(.*)$ discussions.php?id=$1&thread=$2&page=$3 [END]
    RewriteRule ^groups/(.*)/discussions/(.*)/id/page/(.*)$ discussions.php?alias=$1&thread=$2&page=$3 [END]
    RewriteRule ^groups/(.*)/id/discussions/(.*)/id$ discussions.php?id=$1&thread=$2 [END]
    RewriteRule ^groups/(.*)/discussions/(.*)/id$ discussions.php?alias=$1&thread=$2 [END]
    RewriteRule ^groups/(.*)/id$ groups.php?id=$1 [END]
    RewriteRule ^groups/(.*)$ groups.php?alias=$1 [END]

    RewriteRule ^credits/habboclub$ habblet/ajax_habboclub_gift.php [QSA,END]
    RewriteRule ^credits/club/(.*)$ $1.php [QSA,END]
    RewriteRule ^credits/(.*)$ $1.php [QSA,END]
    RewriteRule ^iot/go$ iot.php [QSA,END]
    RewriteRule ^help/faqsearch$ help.php [QSA,END]
    RewriteRule ^help/(.*)$ help.php?id=$1 [END]
    RewriteRule ^cacheCheck$ habblet/null.php?return=true [END]
    RewriteRule ^clientlog/(.*)$ habblet/null.php [END]
    RewriteRule ^components/(.*)$ habblet/components_$1.php [END]
    RewriteRule ^client_popup/(.*)$ clientutils.php?key=$1 [END]
    RewriteRule ^client_(.*)$ clientutils.php?key=$1 [QSA,END]
    RewriteRule ^tag/search$ tag.php [QSA,END]
    RewriteRule ^tag/(.*)$ tag.php?tag=$1 [QSA,END]
    RewriteRule ^mod/localizations$ habblet/mod_localizations.php [END]
    RewriteRule ^mod/add_(.*)_report$ habblet/mod_add_report.php?type=$1 [QSA,END]
    RewriteRule ^trax/song/(.*)$ habblet/trax_song.php?id=$1 [END]
    RewriteRule ^discussions/(.*)/(.*)$ habblet/discussions_$1_$2.php [END]
    RewriteRule ^housekeeping/settings/(.*)$ housekeeping/settings.php?page=$1 [QSA,END]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+)?$ $0.php [END]
</IfModule>
